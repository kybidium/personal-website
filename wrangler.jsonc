{
  // Static Astro site served by a Cloudflare Worker. `npm run build` writes dist/.
  "name": "luisojeda",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "luisojeda.org", "custom_domain": true },
    { "pattern": "www.luisojeda.org", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
